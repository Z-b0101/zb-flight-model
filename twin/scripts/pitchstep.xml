<?xml version="1.0"?>
<runscript name="pitchstep"><use aircraft="zb_twin" initialize="pitchstep_ic"/>
<run start="0" end="20" dt="0.002">
 <property value="0.2510761958475659">fcs/throttle-cmd-norm</property>
 <property value="-0.3971646699965745">fcs/elevator-cmd-norm</property>
 <event name="de_step"><condition>simulation/sim-time-sec ge 2.0</condition>
  <set name="fcs/elevator-cmd-norm" value="-0.5221646699965745"/></event>
</run>
<output name="out_pitchstep.csv" type="CSV" rate="10">
  <property>velocities/vt-fps</property>
  <property>position/h-sl-ft</property>
  <property>aero/alpha-deg</property>
  <property>attitude/theta-deg</property>
  <property>attitude/phi-deg</property>
  <property>attitude/psi-deg</property>
  <property>position/distance-from-start-mag-mt</property>
  <property>velocities/q-rad_sec</property>
  <property>velocities/p-rad_sec</property>
  <property>fcs/elevon-sym-deg</property>
  <property>fcs/elevon-diff-deg</property>
</output></runscript>