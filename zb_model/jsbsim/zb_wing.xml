     </table>
     <product>
      <property>fcs/elevon-sym-deg</property>
      <property>fcs/elevon-sym-deg</property>
      <value>1.3e-4</value>
     </product>
    </sum>
   </function>
  </axis>
  <axis name="SIDE">
   <function name="aero/coefficient/CY">
    <description>CY_beta ESTIMATE - calibrate in flight test</description>
    <product>
     <property>aero/beta-deg</property>
     <value>-0.01</value>
    </product>
   </function>
  </axis>
  <axis name="LIFT">
   <function name="aero/coefficient/CL">
    <description>CL(alpha) MH60 linear + gentle stall blend; + elevon lift (ESTIMATE)</description>
    <sum>
     <table>
      <independentVar lookup="row">aero/alpha-deg</independentVar>
      <tableData>
      -10.0 -0.76300
      -9.0 -0.65400
      -8.0 -0.54500
